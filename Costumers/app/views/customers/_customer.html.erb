<div id="<%= dom_id customer %>">
  <div>
    <strong>Name:</strong>
    <%= customer.name %>
  </div>

  <div>
    <strong>Email:</strong>
    <%= customer.email %>
  </div>

  <div>
    <strong>Phone:</strong>
    <%= customer.phone %>
  </div>

  <div>
    <strong>Birth date:</strong>
    <%= customer.birth_date %>
  </div>

</div>

<%= form_with(model: @product) do |form| %>
    <p> 
      <%= form.label :name%> 
      <%= form.text_field :name%> 
    </p>

   <p> 
    <%= form.label :quantidade%> 
    <%= form.number_field :quantidade%> 
   </p>

   <p>  
    <%= form.label :price%> 
    <%= form.number_field :price%>

    </p>

    
    <p><%= form.submit "Salvar"%> </p>

<%end%>
